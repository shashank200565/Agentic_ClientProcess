{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "runtime": "python",
            "entrypoint": "api.main:app"
        }
    },
    "rewrites": [
        {
            "source": "/analyze/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/reports/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/sessions",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/sessions/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/health",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
